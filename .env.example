# Intentionally public Supabase configuration (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact origin; no trailing path. Used for CSRF and all auth redirect URLs.
APP_ORIGIN=http://localhost:3000
# Enable only AFTER configuring Google in Supabase Auth > Providers.
GOOGLE_OAUTH_ENABLED=false

# Server-only. Only "gemini" is implemented in production. "disabled" is valid.
# Voice and text are independently selected. Never set these to a test mock.
VOICE_AI_PROVIDER=gemini
TEXT_AI_PROVIDER=gemini
GEMINI_API_KEY=
# Verified stable Gemini model: audio input + text output + structured outputs.
GEMINI_VOICE_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=30000
AUDIO_MAX_DURATION_SECONDS=60
# PCM16 mono 16kHz, 60 seconds = 1,920,044 bytes. Cap must fit that payload.
AUDIO_MAX_UPLOAD_BYTES=2000000

# Opt-in seed only: a designated DEVELOPMENT account, never your real account.
# The seeder logs in through Auth + RLS; no service_role key is needed.
# DEMO_SEED_CONFIRM=isolated-development-account
# DEMO_EMAIL=takatrack-demo@example.com
# DEMO_PASSWORD=

# Integration/E2E tests: dedicated disposable users in a LOCAL/test project.
# E2E_BASE_URL=http://localhost:3000
# TEST_SUPABASE_URL=http://127.0.0.1:54321
# TEST_SUPABASE_KEY=
# TEST_USER_A_EMAIL=
# TEST_USER_A_PASSWORD=
# TEST_USER_B_EMAIL=
# TEST_USER_B_PASSWORD=
# E2E_EMAIL=takatrack-demo@example.com
# E2E_PASSWORD=
# E2E_ALLOW_MUTATIONS=isolated-test-project
# VISUAL_REFERENCE_DIR=/absolute/path/to/reference-images
